{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aqua",
  "version": "1.0.0",
  "identifier": "dev.aqua.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aqua",
        "width": 380,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#0B0F14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Aqua",
    "shortDescription": "Monitor de hidratação",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
